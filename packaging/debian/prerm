#!/bin/sh
set -e

case "$1" in
remove|deconfigure)
    if [ -d /run/systemd/system ]; then
        systemctl disable --now exxpiano-wifi.service >/dev/null 2>&1 || true
        systemctl disable --now exxpiano-web.service >/dev/null 2>&1 || true
        systemctl disable --now exxpiano-fx.service >/dev/null 2>&1 || true
        systemctl disable --now exxpiano.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
