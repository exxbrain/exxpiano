#!/sbin/openrc-run
# FluidSynth with the piano and the mechanics banks. Settings: /etc/exxpiano.conf (read by exxpiano-env, never run as a shell script).
# exxpiano-run picks the audio output and keeps FluidSynth on a root-only command pipe. The udev rule restarts this service when a USB
# sound card is plugged in or removed.

description="FluidSynth: piano + mechanics soundfonts"
supervisor=supervise-daemon
command=/opt/exxpiano/exxpiano-env
command_args="/etc/exxpiano.conf -- /opt/exxpiano/exxpiano-run"
pidfile="/run/${RC_SVCNAME}.pid"
respawn_delay=2
respawn_max=0
rc_ulimit="-r 95 -l unlimited"
output_logger="logger -t exxpiano -p daemon.info"
error_logger="logger -t exxpiano -p daemon.info"

depend() {
	need localmount
	after alsa udev-settle exxpiano-firstboot
	use logger
}
