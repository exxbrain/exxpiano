#!/bin/bash
# Picks the audio output and starts FluidSynth. Used by exxpiano.service (settings come from /etc/exxpiano.conf).
#
# ALSA_DEVICE=auto (default): prefer a USB audio card, then an I2S DAC on the GPIO header (both with the small buffer), otherwise the
# onboard 3.5 mm output.
# Any other value is used as it is (for example plughw:U24). USB cards often accept only 24/32-bit audio or 4 channels,
# so the automatic choice always goes through the "plughw" layer, which converts format, rate and channels.
#
# FluidSynth keeps running because its stdin is a root-only pipe (CMD_FIFO) that is never closed. The web interface writes
# commands such as "set synth.gain 1.2" into it, so there is no network control port (FluidSynth's -s server mode listens on
# every interface, and has no setting to change that).
#
# For tests: ASOUND_DIR points to a fake /proc/asound, DRY_RUN=1 prints the command instead of running it.
set -euo pipefail

ASOUND="${ASOUND_DIR:-/proc/asound}"
ALSA_DEVICE="${ALSA_DEVICE:-auto}"
PERIOD_SIZE="${PERIOD_SIZE:-600}"   # the onboard jack: 600 x 2 is its smallest clean buffer (see below)
PERIODS="${PERIODS:-2}"
USB_PERIOD_SIZE="${USB_PERIOD_SIZE:-64}"   # USB_*: the buffer of any external card, USB or I2S, chosen automatically or by name (the names are kept for old configs)
USB_PERIODS="${USB_PERIODS:-2}"
USB_WAIT="${USB_WAIT:-8}"          # the most seconds to wait for a USB card to appear at boot
USB_SETTLE="${USB_SETTLE:-6}"       # seconds after the boot that USB devices need to show up (a Pi 3 B: all of them by 3.5 s, the USB audio driver by 4.7 s); later nothing is waited for without a reason
USB_SYSFS="${USB_SYSFS:-/sys/bus/usb/devices}"
UPTIME_FILE="${PROC_UPTIME:-/proc/uptime}"
POLYPHONY="${POLYPHONY:-256}"
CPU_CORES="${CPU_CORES:-3}"        # synthesis threads of FluidSynth (synth.cpu-cores): the voices of a dense piece are shared between the cores
CPU_COUNT="${CPU_COUNT:-$(nproc 2>/dev/null || echo 1)}"
if [ "$CPU_CORES" -ge "$CPU_COUNT" ]; then          # one core always stays for the system, the bridge and the web interface
  CPU_CORES=$(( CPU_COUNT > 1 ? CPU_COUNT - 1 : 1 ))
fi
SAMPLE_RATE="${SAMPLE_RATE:-44100}"     # 48000 for a card that plays 48 kHz natively (plughw then has nothing to convert)
case "$SAMPLE_RATE" in
  44100|48000|88200|96000) ;;
  *) echo "exxpiano: sample rate $SAMPLE_RATE is not one of 44100 48000 88200 96000, using 44100" >&2; SAMPLE_RATE=44100 ;;
esac
export SAMPLE_RATE                    # the level meter reads it too
# The CPU frequency governor for the time FluidSynth runs. With a small buffer a core that is still speeding up misses a period (a click):
# "performance" keeps every core at its top frequency. Empty: the kernel's own choice is left as it is.
CPU_GOVERNOR="${CPU_GOVERNOR-performance}"
GAIN="${GAIN:-0.6}"
REVERB="${REVERB:-0}"
FLUIDSYNTH="${FLUIDSYNTH:-/usr/bin/fluidsynth}"
CMD_FIFO="${CMD_FIFO:-/run/exxpiano.cmd}"
METER="${METER:-1}"                 # 1 = the output goes through the level meter (the web interface shows the peak of each channel and clipping)
METER_DIR="${METER_DIR:-/run/exxpiano-meter}"
ALSA_TAP_CONF="${ALSA_TAP_CONF:-/etc/alsa/conf.d/60-exxpiano-tap.conf}"
METER_PROGRAM="${METER_PROGRAM:-$(dirname "$0")/exxpiano-meter.py}"

# Writes CPU_GOVERNOR for every core that has frequency control (CPUFREQ_DIR: a fake /sys/devices/system/cpu for tests). Never fatal: a board
# or a kernel without cpufreq just plays at the speed it has.
set_governor() {
  local dir="${CPUFREQ_DIR:-/sys/devices/system/cpu}" f done=0
  [ -n "$CPU_GOVERNOR" ] || return 0
  if [[ ! "$CPU_GOVERNOR" =~ ^[a-z]+$ ]]; then
    echo "exxpiano: CPU_GOVERNOR=$CPU_GOVERNOR is not a governor name, the CPU frequency is left as it is" >&2
    return 0
  fi
  for f in "$dir"/cpu[0-9]*/cpufreq/scaling_governor; do
    [ -f "$f" ] || continue
    if ! grep -qw -- "$CPU_GOVERNOR" "${f%/*}/scaling_available_governors" 2>/dev/null; then
      echo "exxpiano: the CPU frequency governor $CPU_GOVERNOR is not available, keeping $(cat "$f" 2>/dev/null)" >&2
      return 0
    fi
    if echo "$CPU_GOVERNOR" 2>/dev/null > "$f"; then done=1; fi
  done
  [ "$done" = 0 ] || echo "exxpiano: CPU frequency governor $CPU_GOVERNOR" >&2
}

# true if the card has a playback device (MIDI keyboards often show up as capture-only USB audio cards)
has_playback() {
  compgen -G "$ASOUND/card$1/pcm*p" >/dev/null
}

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SF2INFO="${SF2INFO:-$HERE/sf2info.py}"

# The preview bank plays while the piano bank loads (exxpiano-synth): the first note sounds seconds after power-on. Nothing runs before it
# that is not needed for that first note: exxpiano-synth itself checks the piano bank (damaged: the last good one) and the memory (too big:
# the largest smaller bank) in the background while the preview plays. A preview that did not load leaves a mark: then, until the file
# changes, the piano bank is loaded by fluidsynth as before and the module is silent until it is in memory.
SYNTH_PROGRAM="${SYNTH_PROGRAM:-$HERE/exxpiano-synth.py}"
PREVIEW_SF2="${PREVIEW_SF2-/opt/exxpiano/soundfonts/piano-preview.sf2}"   # not in the file (one kept from before the preview): the installed one; empty: none
PREVIEW_FAILED="${EXXPIANO_PREVIEW_FAILED:-/run/exxpiano-preview.failed}"
PREVIEW=""
if [ -n "${PREVIEW_SF2:-}" ] && [ -s "$PREVIEW_SF2" ] && [ -f "$SYNTH_PROGRAM" ] && command -v python3 >/dev/null; then
  if [ -e "$PREVIEW_FAILED" ] && ! [ "$PREVIEW_SF2" -nt "$PREVIEW_FAILED" ]; then
    echo "exxpiano: the preview bank $PREVIEW_SF2 did not load before: loading the piano bank without it" >&2
  else
    PREVIEW="$PREVIEW_SF2"
  fi
elif [ -n "${PREVIEW_SF2:-}" ]; then
  echo "exxpiano: the preview bank $PREVIEW_SF2 is missing: loading the piano bank without it" >&2
fi

if [ -z "$PREVIEW" ]; then
  # A bank that is missing or damaged (a deleted file, a half-copied one) must not leave the module silent: fall back to the
  # last bank that is known to have worked (the web interface records it after every successful switch).
  if [ -f "$SF2INFO" ] && command -v python3 >/dev/null && ! python3 "$SF2INFO" --check "${PIANO_SF2:-}" 2>/dev/null; then
    if [ -n "${PIANO_SF2_LAST_GOOD:-}" ] && python3 "$SF2INFO" --check "$PIANO_SF2_LAST_GOOD" 2>/dev/null; then
      echo "exxpiano: ${PIANO_SF2:-<none>} is missing or damaged, using the last good bank $PIANO_SF2_LAST_GOOD" >&2
      PIANO_SF2="$PIANO_SF2_LAST_GOOD"
    fi
  fi

  # A bank that does not fit into the memory of this board (a Pi 3 A+ has 512 MB) would be killed by the kernel again and again: play the
  # largest smaller bank of the library instead and remember the choice, so the page shows what really plays.
  BANKLIB="${BANKLIB:-$HERE/banklib.py}"
  if [ -f "$BANKLIB" ] && command -v python3 >/dev/null && [ -n "${PIANO_SF2:-}" ]; then
    smaller="$(python3 "$BANKLIB" "$PIANO_SF2" "${MECH_SF2:-}" "${BANK_DIR:-/opt/exxpiano/soundfonts}" 2>/dev/null || true)"
    if [ -n "$smaller" ] && [ "$smaller" != "$PIANO_SF2" ]; then
      echo "exxpiano: $PIANO_SF2 does not fit into the memory of this board, using the smaller bank $smaller" >&2
      PIANO_SF2="$smaller"
      CONF_FILE="${EXXPIANO_CONF:-/etc/exxpiano.conf}"
      if [ -w "$CONF_FILE" ]; then
        awk -v new="$smaller" 'index($0, "PIANO_SF2=")==1 {print "PIANO_SF2=" new; next} {print}' "$CONF_FILE" > "$CONF_FILE.tmp" && cat "$CONF_FILE.tmp" > "$CONF_FILE"; rm -f "$CONF_FILE.tmp"
      fi
    fi
  fi
fi

# true while a USB audio device is on the bus but its driver has not taken it yet (ALSA has no card for it so far)
usb_audio_pending() {
  local d
  for d in "$USB_SYSFS"/*:*; do
    [ -r "$d/bInterfaceClass" ] || continue
    [ "$(cat "$d/bInterfaceClass" 2>/dev/null)" = 01 ] || continue
    [ -e "$d/driver" ] || return 0
  done
  return 1
}

uptime_seconds() {
  local u=0
  read -r u _ < "$UPTIME_FILE" 2>/dev/null || u=0
  echo "${u%%.*}"
}

# true if a card that is neither USB nor the onboard jack is an I2S / SoC DAC on the GPIO header (a PCM5102A board with
# dtoverlay=hifiberry-dac, a HiFiBerry DAC+ or a clone with hifiberry-dacplus, a Raspberry Pi DAC+ with rpi-dacplus): not HDMI (vc4hdmi*, and
# "b1" / "bcm2835 HDMI 1" of the firmware driver), nothing else of the bcm2835 driver, and not a virtual card (snd-dummy, snd-aloop).
# $1: the card id, $2: the rest of its line in /proc/asound/cards ("<driver> - <name>").
is_i2s() {
  local id="${1,,}" desc="${2,,}"
  [[ "$id $desc" =~ hdmi|bcm2835|vc4 ]] && return 1
  [[ "$id" =~ ^(dummy|loopback)$ || "$desc" =~ ^(dummy|loopback)\  ]] && return 1
  return 0
}

# prints the kind of card number $1 with id $2 and the rest of its line $3: usb, i2s, onboard, other, or nothing (no playback, HDMI)
card_kind() {
  has_playback "$1" || return 0
  if [ -e "$ASOUND/card$1/usbid" ]; then echo usb
  elif [[ "$2" == Headphones* ]]; then echo onboard
  elif is_i2s "$2" "$3"; then echo i2s
  elif [[ ! "$2 $3" =~ [Hh][Dd][Mm][Ii] ]]; then echo other
  fi
}

# the cards of /proc/asound/cards, one "<number> <id> <driver> - <name>" per line
list_cards() {
  [ -r "$ASOUND/cards" ] || return 0
  sed -n 's/^ *\([0-9][0-9]*\) \[\([^] ]*\) *\]: *\(.*\)/\1 \2 \3/p' "$ASOUND/cards"
}

# prints "<card id> <usb|i2s|onboard|other>" for the best card, or nothing: a USB card, then an I2S DAC, then the onboard jack
pick_card() {
  local usb="" i2s="" onboard="" other="" num id desc kind
  while read -r num id desc; do
    kind="$(card_kind "$num" "$id" "$desc")"
    case "$kind" in
      usb)     [ -n "$usb" ] || usb="$id" ;;
      i2s)     [ -n "$i2s" ] || i2s="$id" ;;
      onboard) [ -n "$onboard" ] || onboard="$id" ;;
      other)   [ -n "$other" ] || other="$id" ;;
    esac
  done < <(list_cards)
  if   [ -n "$usb" ];     then echo "$usb usb"
  elif [ -n "$i2s" ];     then echo "$i2s i2s"
  elif [ -n "$onboard" ]; then echo "$onboard onboard"
  elif [ -n "$other" ];   then echo "$other other"
  fi
}

# prints the kind of the card an explicit device names (plughw:CARD=U24, plughw:U24, hw:1,0, plughw:CARD=U24,DEV=0), or nothing when
# no card of /proc/asound has that id or number
device_kind() {
  local card="${1#*:}" num id desc
  card="${card%%,*}"; card="${card#CARD=}"
  [ -n "$card" ] || return 0
  while read -r num id desc; do
    if [ "$card" = "$id" ] || [ "$card" = "$num" ]; then card_kind "$num" "$id" "$desc"; return 0; fi
  done < <(list_cards)
}

DEVICE="$ALSA_DEVICE"
Z="$PERIOD_SIZE"; C="$PERIODS"
if [ "$ALSA_DEVICE" = auto ]; then
  choice="$(pick_card)"
  waited=0
  while [ "${choice##* }" != usb ] && [ "$waited" -lt "$USB_WAIT" ]; do   # a USB card enumerates late at boot
    # nothing to wait for: the USB devices have had time to show up and no audio device is waiting for its driver (a keyboard that is
    # a capture-only audio card has its driver already, so it does not hold the start back either)
    if [ "$(uptime_seconds)" -ge "$USB_SETTLE" ] && ! usb_audio_pending; then break; fi
    sleep 1; waited=$((waited + 1)); choice="$(pick_card)"
  done
  [ "$waited" -eq 0 ] || echo "exxpiano: waited ${waited} s for a USB sound card" >&2
  [ -n "$choice" ] || { echo "exxpiano: no sound card found (a Raspberry Pi 5 has no 3.5 mm jack: connect a USB sound card or an audio interface)" >&2; exit 1; }
  DEVICE="plughw:CARD=${choice%% *}"
  kind="${choice##* }"
else
  # an explicit card gets the buffer of its kind too: the web page shows and writes the USB_* pair for a USB or I2S card
  kind="$(device_kind "$ALSA_DEVICE")"
fi
# an external card (USB or I2S) has no 10 ms floor like the onboard jack: it gets the small buffer of USB_PERIOD_SIZE x USB_PERIODS
case "$kind" in usb|i2s) Z="$USB_PERIOD_SIZE"; C="$USB_PERIODS" ;; esac
echo "exxpiano: audio output $DEVICE (${kind:-other}), period $Z x $C" >&2

# FluidSynth rejects periods outside 64..8192 and then exits at once (the service would restart forever)
if [ "$Z" -lt 64 ] || [ "$Z" -gt 8192 ]; then
  clamped=$(( Z < 64 ? 64 : 8192 ))
  echo "exxpiano: period $Z is outside FluidSynth's range 64..8192, using $clamped" >&2
  Z="$clamped"
fi

# The onboard jack (bcm2835) never takes a period under 10 ms (444 frames at 44.1 kHz), learns from the GPU only every ~10 ms how much it
# has played, and stops the stream itself when one such report covers the whole buffer. With 2 periods a buffer under ~27 ms therefore
# runs dry again and again, whatever the load (a Pi 3 B: 444 x 2 gave 100-160 xruns a minute even in silence, 560 x 2 about one,
# 600 x 2 none in 5 minutes of a dense piece). 3 periods of 444 (30 ms) are fine; 2 periods get at least 600 frames (27 ms at 44.1 kHz).
# The card is the one the choice or the explicit device resolved to (plughw:0 and hw:0,0 are the jack too); only a device that names no
# card of /proc/asound is taken for the jack by its name.
onboard=0
if [ "$kind" = onboard ]; then onboard=1
elif [ -z "$kind" ] && [[ "$DEVICE" == *Headphones* ]]; then onboard=1
fi
if [ "$onboard" = 1 ]; then
  min2=$(( (600 * SAMPLE_RATE + 44099) / 44100 ))
  if [ "$C" -le 2 ] && [ "$Z" -lt "$min2" ]; then
    echo "exxpiano: the onboard jack clicks with 2 periods under $min2 frames, using $min2 x $C" >&2
    Z="$min2"
  fi
fi

# The level meter: the device is wrapped into `exxpiano_tap` (a copy of the stream goes into a pipe). Without the ALSA file or the program, or with METER=0,
# the card is used directly and nothing else changes.
OUT_DEVICE="$DEVICE"
if [ "$METER" = 1 ] && [ -f "$ALSA_TAP_CONF" ] && [ -f "$METER_PROGRAM" ]; then
  OUT_DEVICE="exxpiano_tap:'$DEVICE'"
fi

if [ -n "$PREVIEW" ]; then
  # the preset of the piano is set for the bridge (FX_ARGS): the synthesizer moves the piano channel to the same one
  read -r -a fx_words <<< "${FX_ARGS:-}"
  PIANO_BANK=0; PIANO_PROG=0
  for ((i = 0; i + 1 < ${#fx_words[@]}; i++)); do
    case "${fx_words[i]}" in
      --piano-bank) PIANO_BANK="${fx_words[i + 1]}" ;;
      --piano-prog) PIANO_PROG="${fx_words[i + 1]}" ;;
    esac
  done
  cmd=(python3 "$SYNTH_PROGRAM" -o audio.driver=alsa -o midi.driver=alsa_seq
       -o "audio.alsa.device=$OUT_DEVICE" -o audio.sample-format=16bits -o "synth.sample-rate=$SAMPLE_RATE"
       -o "audio.period-size=$Z" -o "audio.periods=$C" -o "synth.reverb.active=$REVERB" -o synth.chorus.active=0
       -o "synth.polyphony=$POLYPHONY" -o "synth.cpu-cores=$CPU_CORES" -o "synth.gain=$GAIN"
       --preview "$PREVIEW" --mech "${MECH_SF2:?MECH_SF2 is not set}" --bank "$PIANO_BANK" --prog "$PIANO_PROG"
       --fallback "${PIANO_SF2_LAST_GOOD:-}" "${PIANO_SF2:?PIANO_SF2 is not set}")
else
  cmd=("$FLUIDSYNTH" -a alsa -m alsa_seq
       -o "audio.alsa.device=$OUT_DEVICE" -o audio.sample-format=16bits -r "$SAMPLE_RATE"
       -z "$Z" -c "$C" -R "$REVERB" -C 0 -o "synth.polyphony=$POLYPHONY" -o "synth.cpu-cores=$CPU_CORES" -g "$GAIN"
       "${PIANO_SF2:?PIANO_SF2 is not set}" "${MECH_SF2:?MECH_SF2 is not set}")
fi
# a dry run on a development machine leaves its CPU alone unless a fake one is given
if [ "${DRY_RUN:-0}" != 1 ] || [ -n "${CPUFREQ_DIR:-}" ]; then set_governor; fi
if [ "${DRY_RUN:-0}" = 1 ]; then echo "${cmd[*]}"; exit 0; fi
# the state of a background load is written by exxpiano-synth; without it the web interface switches banks by a restart
[ -n "$PREVIEW" ] || rm -f "${EXXPIANO_BANK_STATE:-/run/exxpiano-bank.json}"
if [ "$OUT_DEVICE" != "$DEVICE" ]; then
  # While the pipe is not read, the audio waits: this shell holds the pipe open (read+write, it never blocks and never breaks) and runs the meter in a
  # loop, so a restart of the meter takes a fraction of the 0.37 s that the pipe can hold.
  mkdir -p "$METER_DIR"
  rm -f "$METER_DIR/pcm" "$METER_DIR/levels.json"
  mkfifo -m 600 "$METER_DIR/pcm"
  exec 6<>"$METER_DIR/pcm"
  # The loop and the meter end with the synthesizer ($$ is the process FluidSynth replaces below): OpenRC stops only that process, and a loop
  # left behind would read the next pipe too. The loop does not keep the pipe open itself (6<&-), so the meter sees its end.
  SYNTH_PID=$$
  # `|| true`: this script runs with set -e, and without it a meter that crashed or was killed would end the loop: nobody would read the pipe
  # again and the synthesizer would wait on it for ever (silence while the MIDI player says it plays; seen on a Pi 3 B).
  ( exec 6<&-; while kill -0 "$SYNTH_PID" 2>/dev/null; do python3 "$METER_PROGRAM" "$METER_DIR/pcm" "$METER_DIR/levels.json" "$SYNTH_PID" || true; sleep 0.2; done ) &
fi
rm -f "$CMD_FIFO"
mkfifo -m 600 "$CMD_FIFO"
exec 3<>"$CMD_FIFO"          # read+write: the pipe never reaches end-of-file, so FluidSynth keeps running
exec "${cmd[@]}" <&3
