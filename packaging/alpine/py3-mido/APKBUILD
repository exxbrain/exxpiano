# Maintainer: Denis Zakharov <noreply@exxpiano.invalid>
# mido (MIDI objects and ports for Python) is not in the repositories of Alpine 3.24; the MIDI bridge of exxpiano needs it.
# Built unchanged from its source release on PyPI; the checksum below pins that release.
pkgname=py3-mido
_pyname=mido
pkgver=1.3.3
pkgrel=0
pkgdesc="MIDI objects for Python"
url="https://github.com/mido/mido"
arch="noarch"
license="MIT"
depends="python3 py3-packaging"
makedepends="py3-gpep517 py3-installer py3-setuptools py3-setuptools_scm py3-wheel"
options="!check"
source="https://files.pythonhosted.org/packages/source/m/$_pyname/$_pyname-$pkgver.tar.gz"
builddir="$srcdir/$_pyname-$pkgver"

build() {
	SETUPTOOLS_SCM_PRETEND_VERSION=$pkgver gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

sha512sums="
9a9b983b7d2cc6ea530f98df09bc84690dfc980467726217023991a680a7c3f294bb0ffac730e79dcc5a3e4afccacfb4423791df290a035260513a5f7cc26152  mido-1.3.3.tar.gz
"
