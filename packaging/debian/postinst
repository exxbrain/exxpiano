#!/bin/sh
set -e

case "$1" in
configure)
    udevadm control --reload >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        # services of earlier manual setups compete for the sound card and the MIDI ports
        for old in fluidsynth-live midi-autoconnect; do
            if systemctl cat "$old.service" >/dev/null 2>&1; then
                systemctl disable --now "$old.service" >/dev/null 2>&1 || true
            fi
        done
        systemctl daemon-reload
        # the setup access point is started by exxpiano-wifi itself: the packages' own services would only get in the way
        for dep in hostapd dnsmasq; do
            if systemctl cat "$dep.service" >/dev/null 2>&1; then
                systemctl disable --now "$dep.service" >/dev/null 2>&1 || true
            fi
        done
        # a new device with a generic name (dietpi, raspberrypi ...) gets a unique one: exxpiano-<last digits of its Wi-Fi address>; a chosen name is kept
        python3 /opt/exxpiano/exxpiano-wifi.py ensure-name >/dev/null 2>&1 || true
        systemctl enable exxpiano.service exxpiano-fx.service exxpiano-web.service exxpiano-wifi.service >/dev/null 2>&1 || true
        # the banks the configuration points to (an installation may keep them anywhere), not a fixed place
        conf_value() { sed -n "s/^$1=//p" /etc/exxpiano.conf 2>/dev/null | tail -1 | tr -d '"'; }
        piano="$(conf_value PIANO_SF2)"; mech="$(conf_value MECH_SF2)"
        if [ -f "${piano:-/opt/exxpiano/soundfonts/piano.sf2}" ] && [ -f "${mech:-/opt/exxpiano/soundfonts/mech.sf2}" ]; then
            systemctl restart exxpiano.service
            systemctl restart exxpiano-fx.service
            systemctl restart exxpiano-web.service
            systemctl restart exxpiano-wifi.service || true
        else
            echo "exxpiano: the sound banks are not installed yet." >&2
            echo "  Install the exxpiano-soundfonts package or run:" >&2
            echo "  sudo exxpiano-install-banks --piano piano.sf2 --mech mech.sf2" >&2
        fi
    fi
    ;;
esac

exit 0
