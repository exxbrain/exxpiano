#!/sbin/openrc-run
# The piano mechanics MIDI bridge (keyboards -> FluidSynth). It finds the synthesizer and the keyboards by itself, so a restart of the
# synthesizer does not need a restart of this service. FX_ARGS of /etc/exxpiano.conf become its options.

description="Piano mechanics MIDI bridge (keyboards -> FluidSynth)"
supervisor=supervise-daemon
command=/opt/exxpiano/exxpiano-env
# command_args is evaluated by a shell: the quotes keep $FX_ARGS for exxpiano-env, which takes it from the settings file
command_args="--nice -5 /etc/exxpiano.conf -- /usr/bin/python3 /opt/exxpiano/exxpiano-fx.py '\$FX_ARGS'"
pidfile="/run/${RC_SVCNAME}.pid"
respawn_delay=2
respawn_max=0
output_logger="logger -t exxpiano-fx -p daemon.info"
error_logger="logger -t exxpiano-fx -p daemon.info"

# In the boot runlevel and before the network, like the synthesizer: the keyboard must reach it as soon as it sounds.
depend() {
	need localmount
	after exxpiano modules
	before networking
	use logger
}
